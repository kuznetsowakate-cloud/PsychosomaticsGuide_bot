# ── Telegram ──────────────────────────────────────
BOT_TOKEN=ваш_токен_от_BotFather

# Ваш Telegram ID (можно узнать у @userinfobot)
# Несколько через запятую: 123456789,987654321
ADMIN_IDS=123456789

# ── OpenAI (для векторизации) ──────────────────────
OPENAI_API_KEY=sk-...

# ── Anthropic Claude (для генерации ответов) ───────
ANTHROPIC_API_KEY=sk-ant-...

# ── Supabase ───────────────────────────────────────
# Project URL: Settings → API → Project URL
SUPABASE_URL=https://xxxxxxxx.supabase.co

# anon/public key: Settings → API → Project API keys
SUPABASE_KEY=eyJ...

# ── Google Drive (автосинхронизация PDF) ───────────
# Локально: путь к JSON файлу сервис-аккаунта Google
GOOGLE_SERVICE_ACCOUNT_JSON=credentials.json

# На Railway/cloud: содержимое JSON целиком (вставить всё содержимое credentials.json)
# GOOGLE_SERVICE_ACCOUNT_JSON_CONTENT={"type":"service_account","project_id":...}

# ID папки Google Drive (из URL папки: /folders/ВОТ_ЭТО)
DRIVE_FOLDER_ID=

# Как часто проверять папку (в минутах, по умолчанию 60)
DRIVE_SYNC_INTERVAL_MINUTES=60
